# Required shared runner secret (generate with: openssl rand -hex 32)
ORBITAL_RUNNER_TOKEN=replace-with-a-long-random-secret

# Required shared infra-agent secret (generate with: openssl rand -hex 32).
# infra-agent is a separate, differently-privileged service from
# orbital-runners above — it needs Docker-socket / Kubernetes access to
# support the CI/CD and infrastructure monitoring surfaces.
ORBITAL_INFRA_AGENT_TOKEN=replace-with-a-long-random-secret

# Public browser configuration
VITE_API_URL=http://localhost:3000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=replace-me

# API configuration; copy these into server/.env as well.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-me
SUPABASE_SECRET_KEY=replace-me
OPENROUTER_API_KEY=replace-me
ORBITAL_ENCRYPTION_KEY=replace-with-a-32-byte-key
