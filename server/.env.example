OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_server_only_secret_key
# A URL-safe Fernet key used by the upcoming BYOK credential vault. Generate and store it in your secret manager; never commit it.
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Store only in your cloud/self-host secret manager; rotating it requires re-encrypting provider credentials.
ORBITAL_ENCRYPTION_KEY=
ORBITAL_SCHEDULE_WORKER_ENABLED=false
# Comma-separated browser origins. Set this to the exact HTTPS application domains in production.
ORBITAL_CORS_ORIGINS=http://localhost:5173

# CI/CD + infrastructure monitoring (phase 1, read-only). Leave unset in
# local dev without Docker Compose; infra_gateway/ci_ingestion degrade to
# "unavailable" rather than erroring when these are empty.
ORBITAL_INFRA_AGENT_URL=
ORBITAL_INFRA_AGENT_TOKEN=
ORBITAL_CI_SYNC_ENABLED=false
GITHUB_API_URL=https://api.github.com
GITHUB_WEBHOOK_SECRET=
GITHUB_POLL_TOKEN=

# Personal GitHub OAuth (repo-discovery picker only — see
# supabase/migrations/20260823_orbital_github_oauth.sql). Register a GitHub
# OAuth App with this exact callback URL.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/auth/github/callback
